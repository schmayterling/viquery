{
  "name": "viquery",
  "productName": "viquery",
  "version": "0.1.0",
  "description": "offline semantic media library",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --experimental-strip-types 'tests/**/*.test.ts'",
    "check": "npm run lint && npm run typecheck && npm test",
    "package": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "onnxruntime-node@1.30.0": true,
    "fsevents@2.3.3": true,
    "protobufjs": false,
    "@parcel/watcher": false
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@parcel/watcher": "2.6.0",
    "@tanstack/react-virtual": "3.14.21",
    "geist": "1.8.1",
    "justified-layout": "4.1.0",
    "lucide-react": "1.59.0",
    "onnxruntime-node": "1.30.0",
    "sharp": "0.35.5"
  }
}
